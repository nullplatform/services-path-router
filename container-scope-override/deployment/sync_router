#!/bin/bash

# Runs inside the target scope's deploy workflows (initial, blue_green,
# switch_traffic, finalize, rollback, delete). Re-runs `update` on the
# path-router service of the application that routes to the scope being
# deployed, so its HTTPRoute follows the scope's Kubernetes services.
#
# The body is a function so the early outs can `return`: the np CLI ends the
# whole workflow when a step script calls `exit 0`, skipping the steps after it.
main() {
  echo "=== Starting sync_router ==="

  APPLICATION_NRN=$(jq -r .application.nrn <<< "$CONTEXT")

  # The spec's slug depends on how it was registered: "np-path-router" when the
  # package is installed (values.yaml), "path-router" for a copy registered from
  # the specs directory. Both are looked up unless
  # PATH_ROUTER_SERVICE_SPECIFICATION_SLUG names one.
  if [[ -n "${PATH_ROUTER_SERVICE_SPECIFICATION_SLUG:-}" ]]; then
    SPEC_SLUGS=$(jq -cn --arg slug "$PATH_ROUTER_SERVICE_SPECIFICATION_SLUG" '[$slug]')
  else
    SPEC_SLUGS=$(jq -cn --arg slug "${SERVICE_SPECIFICATION_SLUG:-}" '[$slug, "np-path-router", "path-router"] | map(select(. != "")) | unique')
  fi

  echo "Spec: $(jq -r 'join(" or ")' <<< "$SPEC_SLUGS"), application: $APPLICATION_NRN"

  # Step 1: the service specifications visible to the application. A failed
  # list is not "the router isn't installed": skipping the sync would leave the
  # route on the previous backend.
  echo "DEBUG: Fetching service specifications..."
  if ! SERVICE_SPECS=$(np service specification list --nrn "$APPLICATION_NRN" --type dependency --format json); then
    echo "Error: could not list the service specifications visible to $APPLICATION_NRN: $SERVICE_SPECS"
    exit 1
  fi
  if ! jq -e '.results | type == "array"' >/dev/null 2>&1 <<< "$SERVICE_SPECS"; then
    echo "Error: unexpected response listing the service specifications of $APPLICATION_NRN: $SERVICE_SPECS"
    exit 1
  fi

  # The same spec can be listed more than once (one per NRN level): keep ids.
  MATCHED_SPEC_IDS=$(jq -c --argjson slugs "$SPEC_SLUGS" '
    [.results[] | select(.slug as $slug | $slugs | index($slug)) | .id] | unique
  ' <<< "$SERVICE_SPECS")

  # This override runs on every deploy of the scope, including applications
  # that never installed the router. A missing spec means there is nothing to
  # sync, not a failed deploy; it is logged as a warning because a spec
  # registered under another slug looks the same and would leave its route on
  # the previous backend.
  if [[ "$(jq 'length' <<< "$MATCHED_SPEC_IDS")" -eq 0 ]]; then
    echo "WARNING: no service specification with slug $(jq -r 'join(" or ")' <<< "$SPEC_SLUGS") visible to $APPLICATION_NRN, skipping router sync (if the router is installed under another slug, set PATH_ROUTER_SERVICE_SPECIFICATION_SLUG in the agent environment)"
    return 0
  fi

  echo "DEBUG: MATCHED_SPEC_IDS=$MATCHED_SPEC_IDS"

  # Step 2: the active service instance that routes to the scope being deployed.
  # An application can hold several instances (one per scope/environment, or
  # leftovers whose creation failed), so matching only by specification is not
  # enough.
  SCOPE_SLUG=$(jq -r '.scope.slug // empty' <<< "$CONTEXT")

  if [[ -z "$SCOPE_SLUG" ]]; then
    echo "Error: Could not read the scope slug from the deployment context"
    exit 1
  fi

  echo "DEBUG: SCOPE_SLUG=$SCOPE_SLUG"
  echo "DEBUG: Fetching services for application..."
  if ! SERVICES=$(np service list --nrn "$APPLICATION_NRN" --format json); then
    echo "Error: could not list the services of $APPLICATION_NRN: $SERVICES"
    exit 1
  fi

  CANDIDATE_IDS=$(jq -r --argjson spec_ids "$MATCHED_SPEC_IDS" '
    .results[]
    | select((.specification_id as $id | $spec_ids | index($id)) and .status == "active")
    | .id
  ' <<< "$SERVICES")

  SERVICE_ID=""
  SERVICE_DATA=""
  SERVICE_SPEC_ID=""

  for CANDIDATE_ID in $CANDIDATE_IDS; do
    CANDIDATE_DATA=$(np service read --id "$CANDIDATE_ID" --format json)
    CANDIDATE_SCOPE=$(jq -r '.attributes.scope // empty' <<< "$CANDIDATE_DATA")
    echo "DEBUG: Candidate service[id=$CANDIDATE_ID] routes to scope '$CANDIDATE_SCOPE'"

    if [[ "$CANDIDATE_SCOPE" != "$SCOPE_SLUG" ]]; then
      continue
    fi

    # One router per scope is enforced within a specification; two can only
    # meet here when the package and a registered copy are both visible and
    # each has an instance for this scope. Pinning the slug picks one.
    if [[ -n "$SERVICE_ID" ]]; then
      echo "Error: services $SERVICE_ID and $CANDIDATE_ID both route to scope '$SCOPE_SLUG' under different specifications; set PATH_ROUTER_SERVICE_SPECIFICATION_SLUG in the agent environment to the one to sync"
      exit 1
    fi

    SERVICE_ID="$CANDIDATE_ID"
    SERVICE_DATA="$CANDIDATE_DATA"
    SERVICE_SPEC_ID=$(jq -r .specification_id <<< "$CANDIDATE_DATA")
  done

  if [[ -z "$SERVICE_ID" ]]; then
    echo "Could not find an active path-router service routing to scope '$SCOPE_SLUG', skipping router sync"
    return 0
  fi

  echo "DEBUG: SERVICE_ID=$SERVICE_ID SERVICE_SPEC_ID=$SERVICE_SPEC_ID"

  # Step 3: Get service attributes as parameters
  echo "DEBUG: Reading service attributes..."
  PARAMETERS=$(jq -c .attributes <<< "$SERVICE_DATA")
  export PARAMETERS

  echo "DEBUG: PARAMETERS=$PARAMETERS"

  # Step 4: the specification's update action. Its slug derives from the spec's
  # NAME ("update-path-router" for both the package and a copy), so it is found
  # by type, never by rebuilding the slug.
  echo "DEBUG: Fetching action specifications (looking for type: update)..."
  SERVICE_ACTIONS=$(np service specification action specification list --serviceSpecificationId "$SERVICE_SPEC_ID" --format json)

  ACTION_SPEC_ID=$(jq -r '
    .results
    | map(select(.type == "update"))
    | .[0].id // empty
  ' <<< "$SERVICE_ACTIONS")

  if [[ -z "$ACTION_SPEC_ID" ]]; then
    echo "Error: Could not find an update action specification for service specification '$SERVICE_SPEC_ID'"
    exit 1
  fi

  echo "DEBUG: ACTION_SPEC_ID=$ACTION_SPEC_ID"

  # Step 5: Create service action with parameters (with retry for concurrency)
  echo "DEBUG: Creating service action..."

  MAX_CREATE_RETRIES=10
  RETRY_DELAY=5
  create_attempt=0
  ACTION_ID=""

  while [[ -z "$ACTION_ID" || "$ACTION_ID" == "null" ]]; do
    ((create_attempt++))
    echo "DEBUG: Create attempt $create_attempt/$MAX_CREATE_RETRIES"

    if [ "$create_attempt" -gt $MAX_CREATE_RETRIES ]; then
      echo "Error: Maximum number of create attempts (${MAX_CREATE_RETRIES}) reached. Could not create action."
      exit 1
    fi

    # Add delay before retry (except on first attempt)
    if [ "$create_attempt" -gt 1 ]; then
      echo "DEBUG: Waiting ${RETRY_DELAY} seconds before retry..."
      sleep $RETRY_DELAY
    fi

    # Try to create the action
    ACTION_RESPONSE=$(np service action create --serviceId "$SERVICE_ID" --body "$(jq -n --argjson params "$PARAMETERS" --arg spec_id "$ACTION_SPEC_ID" '{name: "update", parameters: $params, specification_id: $spec_id}')" --format json 2>&1 || true)

    # Check if response contains an error about action already in progress
    if echo "$ACTION_RESPONSE" | grep -q "already an action with status.*in_progress"; then
      echo "DEBUG: Action already in progress detected"

      # Try to find the existing in_progress action
      echo "DEBUG: Attempting to find existing in_progress action..."
      EXISTING_ACTIONS=$(np service action list --serviceId "$SERVICE_ID" --format json)
      EXISTING_ACTION_ID=$(jq -r --arg spec_id "$ACTION_SPEC_ID" '
        .results
        | map(select(.specification_id == $spec_id and .status == "in_progress"))
        | .[0].id // empty
      ' <<< "$EXISTING_ACTIONS")

      if [[ -n "$EXISTING_ACTION_ID" ]]; then
        echo "DEBUG: Found existing in_progress action with ID: $EXISTING_ACTION_ID"
        ACTION_ID="$EXISTING_ACTION_ID"
        echo "Using existing action instead of creating new one"
        break
      fi

      echo "DEBUG: No existing action found, will retry..."
    elif echo "$ACTION_RESPONSE" | grep -q 'FST_ERR_VALIDATION'; then
      # Validation errors are deterministic: retrying the same payload cannot succeed
      echo "ERROR: Action parameters were rejected by validation: $ACTION_RESPONSE"
      exit 1
    elif echo "$ACTION_RESPONSE" | grep -q '"error"'; then
      echo "ERROR: Failed to create action: $ACTION_RESPONSE"
      echo "DEBUG: Will retry after delay..."
    else
      # Success - extract action ID
      ACTION_ID=$(echo "$ACTION_RESPONSE" | jq -r '.id // empty')

      if [[ -n "$ACTION_ID" && "$ACTION_ID" != "null" ]]; then
        echo "DEBUG: ACTION_ID=$ACTION_ID"
        echo "Created path-router update action[id=$ACTION_ID], waiting for its completion"
        break
      else
        echo "DEBUG: Could not extract ACTION_ID from response: $ACTION_RESPONSE"
        echo "DEBUG: Will retry after delay..."
      fi
    fi
  done

  # Step 6: Wait for action to complete
  MAX_ITERATIONS=20
  iteration=0

  echo "DEBUG: Starting polling loop for action status..."
  while true; do
    ((iteration++))
    echo "DEBUG: Iteration $iteration/$MAX_ITERATIONS"

    if [ "$iteration" -gt $MAX_ITERATIONS ]; then
      echo "Error: Maximum number of iterations (${MAX_ITERATIONS}) reached. Could not update the path router."
      exit 1
    fi

    echo "DEBUG: Reading action status..."
    ACTION_RESPONSE=$(np service action read --serviceId "$SERVICE_ID" --id "$ACTION_ID" --format json)
    ACTION_STATUS=$(jq -r .status <<< "$ACTION_RESPONSE")

    echo "Checking path-router update action[id=$ACTION_ID, status=$ACTION_STATUS]"

    if [[ "$ACTION_STATUS" == "success" ]]; then
      echo "✅ Path router successfully updated"
      break
    elif [[ "$ACTION_STATUS" == "failed" ]]; then
      echo "❌ Could not update the path router, deployment will be rolled back"
      exit 1
    fi

    echo "DEBUG: Sleeping for 5 seconds..."
    sleep 5
  done

  echo "=== sync_router completed successfully ==="
}

main
