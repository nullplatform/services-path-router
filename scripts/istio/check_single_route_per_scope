#!/bin/bash
set -euo pipefail

# A path router publishes a scope (domain/path -> scope); the app routes its own
# endpoints behind that prefix. Deploys only re-point one route per scope
# (container-scope-override/deployment/sync_router), so a second route on the
# same scope would keep the previous deployment's backend and answer 500 after
# the next deploy. Reject it here, before any route is touched.
#
# The body is a function so the early outs can `return`: the np CLI ends the
# whole workflow when a step script calls `exit 0`, skipping the steps after it.
main() {
    local service nrn spec_id services candidate_ids candidate candidate_scope

    if ! service=$(np service read --id "$SERVICE_ID" --format json); then
        echo "WARNING: could not read service $SERVICE_ID, skipping the one-route-per-scope check"
        return 0
    fi
    nrn=$(echo "$service" | jq -r '.entity_nrn // empty')
    spec_id=$(echo "$service" | jq -r '.specification_id // empty')

    if [[ -z "$nrn" || -z "$spec_id" ]]; then
        echo "WARNING: service $SERVICE_ID has no entity_nrn or specification_id, skipping the one-route-per-scope check"
        return 0
    fi

    if ! services=$(np service list --nrn "$nrn" --format json); then
        echo "WARNING: could not list services of $nrn, skipping the one-route-per-scope check"
        return 0
    fi

    # Same candidates sync_router would pick, plus the ones still being created.
    # Failed leftovers are never synced, so they don't count.
    candidate_ids=$(echo "$services" | jq -r --arg spec "$spec_id" --arg self "$SERVICE_ID" '
        .results // [] | .[]
        | select(.specification_id == $spec and .id != $self)
        | select(.status != "failed" and .status != "deleted" and .status != "deleting")
        | .id')

    for candidate in $candidate_ids; do
        candidate_scope=$(np service read --id "$candidate" --format json | jq -r '.attributes.scope // empty')
        if [[ "$candidate_scope" == "$SCOPE_SLUG" ]]; then
            echo "ERROR: scope '$SCOPE_SLUG' is already published by path router $candidate. Only one path router per scope is supported: expose the app's endpoints under that route's path prefix instead."
            exit 1
        fi
    done

    echo "Scope '$SCOPE_SLUG' has no other path router"
}

main "$@"
