#!/bin/bash
set -euo pipefail

CONTEXT=$(echo "${NP_ACTION_CONTEXT:-$CONTEXT}" | sed "s/^'//;s/'$//" | jq -c '.notification // .')

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id')
SERVICE_SLUG=$(echo "$CONTEXT" | jq -r '.service.slug')
ACTION_ID=$(echo "$CONTEXT" | jq -r '.id')
ACTION_NAME=$(echo "$CONTEXT" | jq -r '.slug')
APPLICATION_ID=$(echo "$CONTEXT" | jq -r '.tags.application_id // ""')

attr() {
  echo "$CONTEXT" | jq -r --arg k "$1" --arg d "$2" '
    if .parameters[$k] != null then .parameters[$k]
    elif .service.attributes[$k] != null then .service.attributes[$k]
    else $d end'
}

BASE_DOMAIN=$(attr base_domain "")
STRIP_PREFIX=$(attr strip_prefix true)
PATH_PREFIX=$(attr path_prefix "")
SCOPE_SLUG=$(attr scope "")

[[ -z "$BASE_DOMAIN" ]]  && { echo "ERROR: base_domain is required in service attributes"; exit 1; }
[[ -z "$PATH_PREFIX" ]]  && { echo "ERROR: path_prefix is required in service attributes"; exit 1; }
[[ -z "$SCOPE_SLUG" ]]   && { echo "ERROR: scope is required in service attributes"; exit 1; }

# All the prefixes this route serves: path_prefix first, then extra_path_prefixes.
PATH_PREFIXES=$(echo "$CONTEXT" | jq -c --arg p "$PATH_PREFIX" '
  [$p] + (.parameters.extra_path_prefixes // .service.attributes.extra_path_prefixes // [])')

if [[ $(echo "$PATH_PREFIXES" | jq 'length != (unique | length)') == "true" ]]; then
  echo "ERROR: path prefixes must not repeat: $PATH_PREFIXES"
  exit 1
fi

export OUTPUT_DIR="${SERVICE_PATH}/output/${SERVICE_SLUG}-${SERVICE_ID}/${ACTION_NAME}-${ACTION_ID}"
mkdir -p "$OUTPUT_DIR"

export SERVICE_ID SERVICE_SLUG ACTION_ID ACTION_NAME APPLICATION_ID
export BASE_DOMAIN STRIP_PREFIX PATH_PREFIX PATH_PREFIXES SCOPE_SLUG
