#!/bin/bash
set -euo pipefail

echo "Checking for path conflicts on $BASE_DOMAIN: $PATH_PREFIXES"

ROUTES=$(kubectl get httproute -n "$K8S_NAMESPACE" \
    -l "nullplatform.com/managed-by=path-router" \
    -o json 2>/dev/null || echo '{"items":[]}')

CONFLICTS=$(echo "$ROUTES" | \
    jq -r --arg domain "$BASE_DOMAIN" --argjson paths "$PATH_PREFIXES" --arg sid "$SERVICE_ID" '
        .items[]
        | select(.spec.hostnames // [] | any(. == $domain))
        | select(.metadata.labels["nullplatform.com/service-id"] != $sid)
        | .metadata.name as $name
        | [.spec.rules[].matches[].path.value] as $taken
        | $paths[] | select(. as $p | $taken | index($p)) | "\(.) (HTTPRoute \($name))"' 2>/dev/null || true)

if [[ -n "$CONFLICTS" ]]; then
    echo "ERROR: path prefixes already claimed on '$BASE_DOMAIN':"
    echo "$CONFLICTS"
    echo "Each path prefix must be unique per domain across all path-router service instances."
    exit 1
fi

echo "No conflicts found — $PATH_PREFIXES on '$BASE_DOMAIN' are available."
